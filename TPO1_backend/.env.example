# ========================================================
# Configuración de Entorno - TPO1_backend (FastAPI / Vercel)
# ========================================================

# Configuración General del Servicio
ENVIRONMENT="production"
PROJECT_NAME="AgendaSalud Backend"
API_V1_STR="/api/v1"

# Seguridad y Autenticación JWT
SECRET_KEY="cambiar-esta-clave-secreta-en-produccion-por-un-string-aleatorio-seguro"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Base de Datos MongoDB Atlas (NoSQL)
MONGODB_URI="mongodb+srv://<usuario>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="agendasalud_tpo1"

# Base de Datos Alternativa Neon Postgres (si se utiliza conector relacional)
# DATABASE_URL="postgresql+asyncpg://<usuario>:<password>@ep-example.neon.tech/neondb?sslmode=require"

# Servicio de Correo Electrónico (SMTP para Recuperación de Contraseña)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="soporte.agendasalud@gmail.com"
SMTP_PASSWORD="tu-app-password-de-gmail"
SMTP_FROM_EMAIL="soporte.agendasalud@gmail.com"
SMTP_FROM_NAME="AgendaSalud Soporte"

# URL base para restablecimiento de contraseña en frontend/app
FRONTEND_RESET_PASSWORD_URL="agendasalud://reset-password"

