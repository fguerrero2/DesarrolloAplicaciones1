    <!-- Ayuda y guía de bienvenida -->
    <string name="ayuda_menu">¿Cómo funciona?</string>
    <string name="ayuda_titulo">Cómo funciona AgendaSalud</string>
    <string name="guia_titulo">Te damos la bienvenida</string>
    <string name="guia_introduccion">Un resumen rápido para empezar. Podés volver a verlo cuando quieras desde ⋮ → ¿Cómo funciona?</string>
    <string name="guia_empezar">Empezar</string>
    <string name="ayuda_pasos_titulo">Primeros pasos</string>
    <string name="ayuda_pasos">1. Cargá tus pacientes en la pestaña Pacientes.\n2. En Hoy o Agenda, tocá un horario disponible para dar un turno.\n3. Al terminar la sesión, tocá el turno → Completar sesión y registrá el cobro.</string>
    <string name="ayuda_turnos_titulo">Turnos</string>
    <string name="ayuda_turnos">Atendés de lunes a viernes de 9 a 18 y los sábados de 9 a 12. Tocá un turno para completarlo, reprogramarlo o cancelarlo. Si te equivocás, la mayoría de las acciones se pueden deshacer desde el aviso que aparece abajo.</string>
    <string name="ayuda_cobros_titulo">Cobros y saldos</string>
    <string name="ayuda_cobros">Cada sesión completada genera un cargo, que podés cobrar en partes, en efectivo o por Mercado Pago. Si cargaste mal un cobro, anulalo desde Cobros → Todos. El saldo se calcula solo.</string>
    <string name="ayuda_inactivos_titulo">Pacientes inactivos</string>
    <string name="ayuda_inactivos">Desactivar a un paciente no borra nada: conserva su historial y su saldo, pero no se le pueden dar turnos nuevos. Podés reactivarlo cuando quieras.</string>
    <string name="ayuda_sync_titulo">Tus datos y la sincronización</string>
    <string name="ayuda_sync">Todo se guarda cifrado en el celular, aun sin internet. Con conexión se sincroniza solo con el servidor, también cifrado, así recuperás tus datos si cambiás de celular. Para hacerlo en el momento: ⋮ → Sincronizar ahora.</string>
    <string name="ayuda_respaldo_titulo">Respaldo en archivo</string>
    <string name="ayuda_respaldo">Además podés exportar un archivo cifrado con ⋮ → Exportar respaldo y guardarlo donde quieras, por ejemplo en Google Drive. Tiene una contraseña propia: si la olvidás, el archivo no se puede abrir.</string>
    <string name="ayuda_contrasenia_titulo">Si olvidás tu contraseña</string>
    <string name="ayuda_contrasenia">En el ingreso, tocá ¿Olvidaste tu contraseña? y seguí el enlace del mail. Hacelo desde el celular que tiene tus datos, así se conserva la copia del servidor.</string>
</resources>
