<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Solo para sincronizar con el backend. Ningún permiso peligroso. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AgendaSaludApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgendaSalud">
        <!-- Acceso: login, registro y apertura de la base. Es la que abre el ícono de la app.
             singleTop: si ya está arriba (login pedido sobre la app) no se apila otra igual. -->
        <activity
            android:name=".presentation.acceso.AccesoActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AgendaSalud"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Enlace del mail de recuperación de contraseña que manda el backend
                 (FRONTEND_RESET_PASSWORD_URL = agendasalud://reset-password?token=…) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="reset-password"
                    android:scheme="agendasalud" />
            </intent-filter>
        </activity>

        <!-- Una Activity por pantalla. No se exportan: solo se abren desde la propia app.
             La barra de navegación las trae adelante con FLAG_ACTIVITY_REORDER_TO_FRONT. -->
        <activity
            android:name=".presentation.turnos.HoyActivity"
            android:exported="false"
            android:theme="@style/Theme.AgendaSalud"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".presentation.turnos.AgendaActivity"
            android:exported="false"
            android:theme="@style/Theme.AgendaSalud"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".presentation.pacientes.PacientesActivity"
            android:exported="false"
            android:theme="@style/Theme.AgendaSalud"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".presentation.pagos.CobrosActivity"
            android:exported="false"
            android:theme="@style/Theme.AgendaSalud"
            android:windowSoftInputMode="adjustResize" />

        <!-- WorkManager se inicializa desde AgendaSaludApp (Configuration.Provider) para que
             Hilt pueda inyectar dependencias en los Workers -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>